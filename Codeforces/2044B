#include <iostream>
#include <string>
#include <vector>
using namespace std;

void solve(){
    string a;
    cin >> a;

    for(int i = a.size()-1; i >= 0; i--){
        if(a[i] == 'p'){
            cout << "q";
        }
        else if(a[i] == 'q'){
            cout << "p";
        }
        else{
            cout << "w";
        }
    }
    cout << "\n";
}

int main(){
    int n;
    cin >> n;

    while(n--){
        solve();
    }
}
